FROM node:22-bookworm-slim AS dependencies

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
	python3 \
	make \
	g++ \
	&& rm -rf /var/lib/apt/lists/*

# Copy ONLY package.json to bypass the broken package-lock.json "Invalid Version:" crash
COPY package.json ./
RUN npm install --omit=dev --legacy-peer-deps --no-package-lock --no-update-notifier

FROM node:22-bookworm-slim

WORKDIR /app
ENV NODE_ENV=production

RUN apt-get update && apt-get install -y --no-install-recommends \
	ca-certificates \
	ffmpeg \
	libstdc++6 \
	libgomp1 \
	&& rm -rf /var/lib/apt/lists/*

COPY --from=dependencies /app/node_modules ./node_modules